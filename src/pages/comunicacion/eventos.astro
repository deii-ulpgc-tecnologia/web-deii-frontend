---
import Layout from "../../layouts/Layout.astro";
import { PATHS } from "@/constants/Site";
import { EVENTS } from "@/constants/Events";

const now = new Date();
const upcomingEvents = EVENTS.filter((e) => e.date >= now).sort(
    (a, b) => a.date.getTime() - b.date.getTime(),
);

const pastEvents = EVENTS.filter((e) => e.date < now).sort(
    (a, b) => b.date.getTime() - a.date.getTime(),
);

const clientEvents = EVENTS.map((e) => ({
    id: e.id,
    title: e.title,
    date: e.date.toISOString(),
}));
---

<Layout title="Eventos - Delegación de Estudiantes">
    <main>
        <div class="header-eventos">
            <h1>Eventos</h1>
            <p>
                Descubre todas las actividades, charlas y encuentros organizados
                por la Delegación.
            </p>
        </div>

        <section
            class="calendar-wrapper"
            id="vanilla-calendar"
            data-events={JSON.stringify(clientEvents)}
        >
            <div class="calendar-header">
                <h2 class="calendar-title">Calendario de Eventos</h2>
                <div class="calendar-controls">
                    <button id="cal-prev" class="cal-nav-btn">
                        &lsaquo;
                    </button>
                    <span id="cal-month-year">Cargando...</span>
                    <button id="cal-next" class="cal-nav-btn">
                        &rsaquo;
                    </button>
                </div>
            </div>

            <div class="calendar-weekdays">
                <span>LUN</span>
                <span>MAR</span>
                <span>MIÉ</span>
                <span>JUE</span>
                <span>VIE</span>
                <span>SÁB</span>
                <span>DOM</span>
            </div>

            <div id="calendar-grid" class="calendar-grid"></div>
        </section>

        <section class="events-section">
            <h2>Próximos Eventos</h2>
            {upcomingEvents.length > 0 ? (
                <div class="events-list">
                    {upcomingEvents.map((e) => (
                        <a
                            id={e.id}
                            href={`${PATHS.EVENTS}/${e.id}`}
                            class="event-card"
                        >
                            <img src={e.image} alt={e.title} />
                            <div class="content">
                                <h3>{e.title}</h3>
                                <div class="meta-info">
                                    <span class="date">
                                        {" "}
                                        {e.date.toLocaleDateString("es-ES", {
                                            day: "numeric",
                                            month: "long",
                                            year: "numeric",
                                            hour: "2-digit",
                                            minute: "2-digit",
                                        })}
                                    </span>
                                    {e.location && (
                                        <span class="location">
                                            📍 {e.location}
                                        </span>
                                    )}
                                </div>
                                <p>{e.content}</p>
                                <span class="read-more">
                                    Ver detalles &rarr;
                                </span>
                            </div>
                        </a>
                    ))}
                </div>
            ) : (
                <p class="empty-state">
                    Actualmente no hay eventos próximos programados.
                </p>
            )}
        </section>

        <hr class="section-divider" />

        <section class="events-section">
            <h2>Eventos Pasados</h2>
            {pastEvents.length > 0 ? (
                <div class="events-list">
                    {pastEvents.map((e) => (
                        <a
                            id={e.id}
                            href={`${PATHS.EVENTS}/${e.id}`}
                            class="event-card past-event"
                        >
                            <img src={e.image} alt={e.title} />
                            <div class="content">
                                <h3>{e.title}</h3>
                                <div class="meta-info">
                                    <span class="date">
                                        {" "}
                                        {e.date.toLocaleDateString("es-ES", {
                                            day: "numeric",
                                            month: "long",
                                            year: "numeric",
                                        })}
                                    </span>
                                </div>
                                <p>{e.content}</p>
                                <span class="read-more">
                                    Ver detalles &rarr;
                                </span>
                            </div>
                        </a>
                    ))}
                </div>
            ) : (
                <p class="empty-state">
                    Aún no hay registro de eventos pasados.
                </p>
            )}
        </section>
    </main>
</Layout>

<style>
    html {
        scroll-behavior: smooth;
        scroll-padding-top: 100px;
    }

    main {
        width: 95%;
        max-width: 1300px;
        margin: 0 auto;
        padding: 40px 20px;
    }

    .header-eventos {
        margin-bottom: 40px;
        text-align: center;
    }

    .header-eventos h1 {
        color: var(--ulpgc-blue);
        font-size: 2.5rem;
        margin-bottom: 10px;
    }

    .header-eventos p {
        color: #666;
        font-size: 1.1rem;
    }

    .calendar-wrapper {
        background: white;
        width: 100%;
        margin: 0 auto 60px auto;
        font-family:
            system-ui,
            -apple-system,
            sans-serif;
        border-radius: 20px;
        padding: 30px;
        border: 2px solid #e1e0e0;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.03);
    }

    .calendar-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 30px;
        padding: 0 10px;
    }

    .calendar-title {
        color: var(--ulpgc-blue, #0056b3);
        font-size: 1.5rem;
        margin: 0;
    }

    .calendar-controls {
        display: flex;
        align-items: center;
        gap: 15px;
        font-size: 1.1rem;
        font-weight: 500;
        color: var(--ulpgc-blue);
        text-transform: capitalize;
    }

    .cal-nav-btn {
        background: transparent;
        border: none;
        color: var(--ulpgc-orange-dark);
        font-size: 1.8rem;
        cursor: pointer;
        padding: 0 10px;
        transition: color 0.2s;
        line-height: 1;
    }

    .cal-nav-btn:hover {
        color: var(--ulpgc-blue, #0056b3);
    }

    .calendar-weekdays {
        display: grid;
        grid-template-columns: repeat(7, 1fr);
        text-align: center;
        font-weight: 600;
        color: #7ab4ffaa;
        font-size: 0.8rem;
        padding-bottom: 10px;
    }

    .calendar-grid {
        display: grid;
        grid-template-columns: repeat(7, minmax(0, 1fr));
        gap: 10px;
    }

    :global(.cal-day) {
        min-height: 120px;
        padding: 10px;
        background: white;
        border: 2px solid #e2e2e2;
        border-radius: 12px;
        display: flex;
        flex-direction: column;
        position: relative;
        transition: all 0.2s ease;
        min-width: 0;
        overflow: hidden;
    }

    :global(.cal-day:not(.empty):hover) {
        border-color: var(--ulpgc-blue, #0056b3);
        box-shadow: 0 0 0 2px var(--ulpgc-blue, #0056b3);
        transform: translateY(-2px);
    }

    :global(.cal-day.other-month) {
        background-color: #f8fafc;
    }

    :global(.cal-day.other-month .cal-day-num) {
        color: #cbd5e1;
    }

    :global(.cal-day.today) {
        border: 2px solid var(--ulpgc-blue, #0056b3);
        z-index: 1;
    }

    :global(.cal-day.today .cal-day-num) {
        color: var(--ulpgc-blue, #0056b3);
        font-weight: bold;
        background: #ebf3ff;
        padding: 2px 6px;
        border-radius: 4px;
    }

    :global(.cal-day-num) {
        font-size: 0.9rem;
        color: #434e60;
        align-self: flex-end;
        margin-bottom: 8px;
    }

    :global(.cal-event-pill) {
        background-color: #ebf3ff;
        color: var(--ulpgc-blue, #0056b3);
        font-size: 0.75rem;
        font-weight: 500;
        padding: 6px 8px;
        border-radius: 6px;
        margin-bottom: 4px;
        cursor: pointer;
        transition: background-color 0.2s;
        display: block;
        max-width: 100%;
        box-sizing: border-box;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    :global(.cal-event-pill:hover) {
        background-color: #d4e7ff;
    }

    .events-section {
        max-width: 1050px;
        margin: 0 auto;
    }

    .events-section h2 {
        color: var(--ulpgc-orange-dark);
        margin-bottom: 25px;
        font-size: 1.8rem;
        border-left: 4px solid var(--ulpgc-orange-dark);
        padding-left: 10px;
    }

    .events-list {
        display: flex;
        flex-direction: column;
        gap: 30px;
    }

    .event-card {
        display: flex;
        text-decoration: none;
        color: inherit;
        border: 1px solid #e0e0e0;
        border-radius: 16px;
        overflow: hidden;
        background: white;
        transition:
            transform 0.2s ease,
            box-shadow 0.2s ease,
            border-color 0.2s ease;
        min-height: 240px;
        scroll-margin-top: 120px;
    }

    .event-card:hover {
        transform: translateY(-5px);
        border-color: var(--ulpgc-blue);
        box-shadow:
            0 10px 30px rgba(0, 0, 0, 0.1),
            0 0 0 2px var(--ulpgc-blue);
    }

    .event-card img {
        width: 40%;
        object-fit: cover;
    }

    .content {
        width: 60%;
        padding: 30px;
        display: flex;
        flex-direction: column;
        position: relative;
    }

    .content h3 {
        color: var(--ulpgc-blue);
        margin: 0 0 15px 0;
        font-size: 1.5rem;
    }

    .meta-info {
        display: flex;
        flex-wrap: wrap;
        gap: 15px;
        margin-bottom: 15px;
        font-size: 0.9rem;
        color: #555;
        font-weight: 500;
    }

    .meta-info span {
        background: #f5f5f5;
        padding: 5px 10px;
        border-radius: 6px;
    }

    .content p {
        color: #444;
        line-height: 1.6;
        margin: 0 0 20px 0;
        display: -webkit-box;
        -webkit-line-clamp: 4;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .read-more {
        margin-top: auto;
        color: var(--ulpgc-orange-dark);
        font-weight: bold;
        align-self: flex-start;
    }

    .past-event {
        opacity: 0.85;
        background-color: #fafafa;
    }

    .past-event img {
        filter: grayscale(40%);
    }

    .section-divider {
        margin: 60px 0;
        border: none;
        border-top: 3px dashed #ddd;
    }

    .empty-state {
        color: #777;
        font-style: italic;
        background: #f9f9f9;
        padding: 20px;
        border-radius: 8px;
        text-align: center;
    }

    @media (max-width: 768px) {
        .calendar-wrapper {
            padding: 15px;
            border-radius: 12px;
        }
        .calendar-grid {
            gap: 5px;
        }
        :global(.cal-day) {
            min-height: 80px;
            padding: 5px;
            border-radius: 8px;
        }

        .event-card {
            flex-direction: column;
        }
        .event-card img {
            width: 100%;
            height: 200px;
        }
        .content {
            width: 100%;
            padding: 20px;
        }
    }
</style>

<script>
    document.addEventListener("DOMContentLoaded", () => {
        const calendarWrapper = document.getElementById("vanilla-calendar");
        if (!calendarWrapper) return;

        const rawEvents = calendarWrapper.getAttribute("data-events") || "[]";
        const events = JSON.parse(rawEvents);

        const prevBtn = document.getElementById("cal-prev");
        const nextBtn = document.getElementById("cal-next");
        const monthYearDisplay = document.getElementById("cal-month-year");
        const grid = document.getElementById("calendar-grid");
        const currentDate = new Date();

        function renderCalendar() {
            if (!grid || !monthYearDisplay) return;

            const year = currentDate.getFullYear();
            const month = currentDate.getMonth();
            const realToday = new Date();

            const formatter = new Intl.DateTimeFormat("es-ES", {
                month: "long",
                year: "numeric",
            });
            monthYearDisplay.textContent = formatter.format(currentDate);

            grid.innerHTML = "";

            const firstDayOfMonth = new Date(year, month, 1).getDay();
            const startOffset = firstDayOfMonth === 0 ? 6 : firstDayOfMonth - 1;

            const daysInMonth = new Date(year, month + 1, 0).getDate();
            const daysInPrevMonth = new Date(year, month, 0).getDate();

            function createCell(
                cellYear: number,
                cellMonth: number,
                cellDay: number,
                extraClass: string,
            ) {
                const cellDate = new Date(cellYear, cellMonth, cellDay);
                const normY = cellDate.getFullYear();
                const normM = cellDate.getMonth();
                const normD = cellDate.getDate();

                const cell = document.createElement("div");

                const isToday =
                    normD === realToday.getDate() &&
                    normM === realToday.getMonth() &&
                    normY === realToday.getFullYear();
                cell.className = `cal-day ${extraClass} ${isToday ? "today" : ""}`;

                const numSpan = document.createElement("span");
                numSpan.className = "cal-day-num";
                numSpan.textContent = normD.toString();
                cell.appendChild(numSpan);

                const dayEvents = events.filter((e: { date: string }) => {
                    const eDate = new Date(e.date);
                    return (
                        eDate.getFullYear() === normY &&
                        eDate.getMonth() === normM &&
                        eDate.getDate() === normD
                    );
                });

                dayEvents.forEach((ev: { id: string; title: string }) => {
                    const pill = document.createElement("div");
                    pill.className = "cal-event-pill";
                    pill.textContent = ev.title;
                    pill.title = ev.title;

                    pill.addEventListener("click", (event) => {
                        event.preventDefault();
                        event.stopPropagation();

                        const targetElement = document.getElementById(ev.id);
                        if (targetElement) {
                            targetElement.scrollIntoView({
                                behavior: "smooth",
                            });

                            targetElement.style.transition = "box-shadow 0.5s";
                            targetElement.style.boxShadow =
                                "0 0 0 3px var(--ulpgc-blue)";
                            setTimeout(() => {
                                targetElement.style.boxShadow = "";
                            }, 1500);
                        }
                    });

                    cell.appendChild(pill);
                });

                grid?.appendChild(cell);
            }

            for (let i = 0; i < startOffset; i++) {
                const dayNum = daysInPrevMonth - startOffset + 1 + i;
                createCell(year, month - 1, dayNum, "other-month");
            }

            for (let i = 1; i <= daysInMonth; i++) {
                createCell(year, month, i, "current-month");
            }

            const totalCellsSoFar = startOffset + daysInMonth;
            const remainder = totalCellsSoFar % 7;
            const trailingDays = remainder === 0 ? 0 : 7 - remainder;

            for (let i = 1; i <= trailingDays; i++) {
                createCell(year, month + 1, i, "other-month");
            }
        }

        prevBtn?.addEventListener("click", () => {
            currentDate.setMonth(currentDate.getMonth() - 1);
            renderCalendar();
        });

        nextBtn?.addEventListener("click", () => {
            currentDate.setMonth(currentDate.getMonth() + 1);
            renderCalendar();
        });

        renderCalendar();
    });
</script>
