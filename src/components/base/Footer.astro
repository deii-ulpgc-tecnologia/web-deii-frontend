---
import { Icon } from "astro-icon/components";
---

<footer>
    <div>
        <img alt="Logo de la DEII" src="/logo-blanco.png" />
    </div>
    <div>
        <span>Contacto General</span>
        <a href="mailto:delegacion.eii@ulpgc.es">delegacion.eii@ulpgc.es</a>
        <span>Redes Sociales</span>
        <a href="/">
            <Icon name="akar-icons:discord-fill" /> Discord. Únete
        </a>
        <a href="https://www.instagram.com/delegacion.eii/">
            <Icon name="akar-icons:instagram-fill" /> @delegacion.eii
        </a>
        <a href="https://www.twitch.tv/deii_ulpgc">
            <Icon name="akar-icons:twitch-fill" /> @deii_ulpgc
        </a>
    </div>
    <div>
        <span>Información</span>
        <a href="/terminos/legal">Legal</a>
        <a href="/terminos/legal">Protección de Datos</a>
        <a href="/terminos/legal">Aviso Legal</a>
        <a href="/terminos/legal">Accesibilidad</a>
        <a href="https://mi.ulpgc.es" class="ulpgc">
            Mi ULPGC
        </a>
    </div>
</footer>

<style>
    footer {
        overflow-x: hidden;
        background: var(--ulpgc-blue);
        width: 100%;
        padding: 20px 40px;
        padding-left: 0;
        display: grid;
        height: fit-content;
        grid-template-columns: 40% repeat(2, auto);
        color: white;

        img {
            width: 70%;
            object-fit: contain;
        }

        h3 {
            font-size: 1.6rem;
        }

        div {
            display: flex;
            height: fit-content;
            flex-direction: column;

            &:has(img) {
                justify-self: center;
                align-self: center;
                display: flex;
                justify-content: center;
                align-items: center;
            }

            span {
                font-weight: bold;
                margin: 10px 0;
            }
        }

        a:not(.ulpgc) {
            color: #ffffffc5;
            display: flex;
            align-items: center;
            gap: 5px;
            text-decoration: none;
            transition: color 0.2s linear;
            margin-bottom: 2px;

            &:hover {
                color: #ffffff95;
            }
        }
    }

    .ulpgc {
        background: var(--ulpgc-orange);
        color: white;
        border: none;
        border-radius: 4px;
        padding: 10px 24px;
        margin-top: 15px;
        font-size: 0.95rem;
        font-weight: bold;
        text-transform: uppercase;
        text-decoration: none;
        cursor: pointer;
        transition: all 0.3s ease;
        display: inline-block;
        text-align: center;
        transition: background 0.3s linear;

        &:hover {
            background-color: var(--ulpgc-orange-dark);
        }
    }

    @media (max-width: 1040px) {
        footer {
            display: flex;
            flex-direction: column;
            padding-left: 40px;

            img {
                width: 300px;
            }
        }
    }
</style>
