---
import { NAVIGATION } from "@/constants/Site";
import NavigationItem from "@/components/base/NavigationItem.astro";
import QuickAuth from "@/components/authentication/QuickAuth.astro";
---

<header>
    <a href="/">
        <img alt="Logo de la DEII" src="/logo.png" />
    </a>
    <nav>
        <ul>
            {NAVIGATION.map((nav) => (
                <NavigationItem
                    label={nav.label}
                    path={nav.path}
                    children={nav.children}
                    icon={nav.icon}
                />
            ))}
        </ul>
    </nav>
    <QuickAuth />
</header>

<style>
    header {
        width: 100%;
        height: 15dvh;
        border-bottom: 4px solid var(--ulpgc-blue);
        box-shadow: 5px 0 20px var(--ulpgc-blue);
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 0 10px;

        > a {
            width: auto;
            height: 100%;

            > img {
                width: auto;
                height: 100%;
            }
        }

        nav {
            height: 100%;
            padding: 0 20px;

            ul {
                height: 100%;
                text-decoration: none;
                list-style: none;
                display: flex;
                justify-content: center;
                align-items: center;
                gap: 15px;
            }
        }
    }
</style>
