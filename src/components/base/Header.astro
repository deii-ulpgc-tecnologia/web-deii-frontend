---
import NAVIGATION from "@/constants/Site";
---

<header>
    <a href="/">
        <img alt="Logo de la DEII" src="logo.png" />
    </a>
</header>

<style>
    header {
        width: 100%;
        height: 10dvh;
        background: var(--ulpgc-blue);
        display: flex;
        padding: 0 10px;
        > a {
            width: auto;
            height: 100%;

            > img {
                width: auto;
                height: 100%;
                --border-size: 0.05px;
                filter: drop-shadow(var(--border-size) 0 0 white)
                    drop-shadow(calc(var(--border-size) * -1) 0 0 white)
                    drop-shadow(0 var(--border-size) 0 white)
                    drop-shadow(0 calc(var(--border-size) * -1) 0 white);
            }
        }
    }
</style>

<script></script>
