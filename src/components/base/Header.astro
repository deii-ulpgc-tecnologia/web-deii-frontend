---
import { NAVIGATION } from "@/constants/Site";
import NavigationItem from "@/components/base/NavigationItem.astro";
import QuickAuth from "@/components/authentication/QuickAuth.astro";
import { Icon } from "astro-icon/components";
---

<header>
    <a href="/">
        <img alt="Logo de la DEII" src="/logo.png" />
    </a>
    <nav>
        <ul>
            {NAVIGATION.map((nav) => (
                <NavigationItem
                    label={nav.label}
                    path={nav.path}
                    children={nav.children}
                    icon={nav.icon}
                />
            ))}
        </ul>
        <div class="auth-mobile">
            <QuickAuth />
        </div>
    </nav>
    <div class="auth-desktop">
        <QuickAuth />
    </div>
    <button class="nav-toggle" aria-label="Menú de navegación">
        <Icon name="lucide:menu" class="icon-open" size={30} />
        <Icon name="lucide:x" class="icon-close" size={30} />
    </button>
    <div class="nav-overlay"></div>
</header>

<script>
    import { $ } from "@/lib/dom-selector";

    function setupNav() {
        const header = $("header");
        const toggle = $<HTMLButtonElement>(".nav-toggle");
        const overlay = $(".nav-overlay");

        toggle.addEventListener("click", () =>
            header.toggleAttribute("data-open"),
        );
        overlay.addEventListener("click", () =>
            header.removeAttribute("data-open"),
        );
    }

    document.addEventListener("astro:page-load", setupNav);
    document.addEventListener("DOMContentLoaded", setupNav);
</script>

<style>
    header {
        width: 100%;
        height: 15dvh;
        border-bottom: 4px solid var(--ulpgc-blue);
        box-shadow: 5px 0 20px var(--ulpgc-blue);
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 0 10px;

        > a {
            width: auto;
            height: 100%;

            > img {
                width: auto;
                height: 100%;
            }
        }

        nav {
            height: 100%;
            padding: 0 20px;

            ul {
                height: 100%;
                text-decoration: none;
                list-style: none;
                display: flex;
                justify-content: center;
                align-items: center;
                gap: 15px;
            }
        }
    }

    .nav-toggle {
        display: none;
        background: none;
        border: none;
        cursor: pointer;
        color: var(--ulpgc-gray);
        z-index: 110;
    }

    .icon-close {
        display: none;
    }

    header[data-open] .icon-open {
        display: none;
    }

    header[data-open] .icon-close {
        display: block;
    }

    .nav-overlay {
        display: none;
    }

    header[data-open] .nav-overlay {
        display: block;
        position: fixed;
        inset: 0;
        background: rgba(0, 0, 0, 0.4);
        z-index: 90;
    }

    .auth-mobile {
        display: none;
    }

    .auth-desktop {
        display: block;
    }

    @media (max-width: 1032px) {
        header {
            height: 10dvh;
        }

        .nav-toggle {
            display: flex;
        }

        .auth-desktop {
            display: none;
        }

        header {
            nav {
                position: fixed;
                top: 0;
                right: 0;
                width: min(75vw, 500px);
                height: 100dvh;
                background: white;
                z-index: 100;
                padding: 80px 20px 30px;
                box-shadow: -2px 0 12px rgba(0, 0, 0, 0.15);
                transform: translateX(100%);
                transition: transform 0.3s ease;
                overflow-y: auto;
                display: flex;
                flex-direction: column;
                gap: 20px;

                ul {
                    flex-direction: column;
                    height: auto;
                    gap: 5px;
                    height: 100%;
                    padding-top: 20%;
                    justify-content: flex-start;
                    align-items: flex-start;
                    font-size: 22px;
                }
            }
        }

        header[data-open] nav {
            transform: translateX(0);
        }

        .auth-mobile {
            display: flex;
            justify-content: center;
            margin-bottom: 2rem;
        }
    }
</style>
