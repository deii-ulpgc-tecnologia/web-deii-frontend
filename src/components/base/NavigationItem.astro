---
import type { NavigationItem as NavigationItemType } from "@/types/Navigation";
import { Icon } from "astro-icon/components";

export type Props = NavigationItemType;

const { label, path, children, icon } = Astro.props;
const currentPath = Astro.url.pathname;
---

<li class:list={{ active: currentPath === path, "has-children": !!children }}>
    <Icon name={icon} />
    <a href={path}>{label}</a>
    {children && (
        <button
            class="dropdown-toggle"
            aria-label="Expandir submenú"
            aria-expanded="false">
            <Icon name="lucide:chevron-up" />
        </button>
    )}
    {children && (
        <ul class="dropdown-content">
            {children.map((nav) => (
                <Astro.self
                    label={nav.label}
                    path={nav.path}
                    children={nav.children}
                    icon={nav.icon}
                />
            ))}
        </ul>
    )}
</li>

<style>
    li {
        display: flex;
        flex-direction: row;
        justify-content: center;
        align-items: center;
        font-size: inherit;
        gap: 5px;
        transition: all 0.2s linear;
        color: var(--ulpgc-gray);
        font-size: 18px;
        position: relative;

        &:hover,
        &.active {
            color: var(--ulpgc-blue);
        }

        button {
            background: transparent;
            border: none;
            outline: none;
        }

        .dropdown-toggle [data-icon="lucide:chevron-up"] {
            transition: all ease-in-out 0.3s;
        }

        &:hover > .dropdown-toggle [data-icon="lucide:chevron-up"] {
            rotate: 180deg;
        }

        &:hover > .dropdown-content,
        .dropdown-content &:hover {
            display: flex;
            opacity: 1;
            transform: translateY(0);
        }
    }

    a {
        text-decoration: none;
        color: inherit;
    }

    .dropdown-toggle {
        background: none;
        border: none;
        cursor: pointer;
        color: inherit;
        padding: 0;
        display: flex;
        align-items: center;
    }

    .dropdown-content {
        display: none;
        position: absolute;
        height: fit-content;
        width: fit-content;
        border-radius: 10px;
        padding-top: 30px;
        float: left;
        bottom: 0;
        top: 0;
        z-index: 1;
        flex-direction: column;
        flex-wrap: nowrap;
        text-wrap: nowrap;
        gap: 0px;
        opacity: 0;
        transform: translateY(-15%);
        transition:
            display 0.1s allow-discrete,
            opacity 0.3s ease,
            transform 0.2s ease;

        & li {
            background: white;
            width: 100%;
            box-shadow: 0px 8px 16px 0px rgba(0, 0, 0, 0.2);
            padding: 10px 20px;
            text-align: left;
            justify-content: flex-start;
            flex-wrap: nowrap;
            text-wrap: nowrap;

            &:first-child {
                border-radius: 5px 5px 0 0;
            }

            &:last-child {
                border-radius: 0 0 5px 5px;
            }
        }
    }

    @starting-style {
        li:hover > .dropdown-content {
            opacity: 0;
            transform: translateY(-15%);
        }
    }

    @media (max-width: 1032px) {
        li {
            justify-content: flex-start;
            flex-wrap: wrap;
            font-size: inherit;
        }

        .dropdown-toggle [data-icon="lucide:chevron-up"] {
            margin-left: auto;
            width: 20;
            height: 20;
        }

        li[data-expanded] > .dropdown-toggle [data-icon="lucide:chevron-up"] {
            rotate: 180deg;
        }

        li[data-expanded] > .dropdown-content {
            display: flex;
            position: static;
            width: 100%;
            opacity: 1;
            transform: none;
            padding-top: 5px;
            padding-left: 15px;
            border-radius: 0;
            gap: 0;
        }

        li[data-expanded] > .dropdown-content li {
            box-shadow: none;
            padding: 8px 10px;
        }

        .dropdown-content {
            transition: none;
        }

        /* Disable hover dropdown on mobile */
        li:hover > .dropdown-content {
            display: none;
        }

        li[data-expanded]:hover > .dropdown-content {
            display: flex;
        }
    }
</style>

<script>
    import { $$ } from "@/lib/dom-selector";

    function setupDropdowns() {
        const toggles = $$<HTMLButtonElement>(".dropdown-toggle");

        toggles.forEach((btn) => {
            btn.addEventListener("click", () => {
                const li = btn.closest("li");
                if (!li) return;

                const isExpanded = li.hasAttribute("data-expanded");
                li.toggleAttribute("data-expanded");
                btn.setAttribute("aria-expanded", String(!isExpanded));
            });
        });
    }

    document.addEventListener("astro:page-load", setupDropdowns);
    document.addEventListener("DOMContentLoaded", setupDropdowns);
</script>
