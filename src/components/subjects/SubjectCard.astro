---
import type { MarkdownSubject } from "@/types/Subject";
import { DEGREES, SEMESTERS, TYPES, YEARS } from "@/constants/SubjectsConfig";
import Tag from "@/components/base/Tag.astro";
import CardDataHolder from "@/components/subjects/CardDataHolder.astro";
import { Icon } from "astro-icon/components";

export type Props = Omit<
    MarkdownSubject,
    "teaching_guide" | "subject_url" | "Content"
>;

const {
    name,
    degree,
    year,
    semester,
    description,
    type,
    bg_color,
    code,
    credits,
    slug,
    degree_color,
} = Astro.props;

const semesterLabel =
    SEMESTERS.find((s) => s.id === semester)?.label ?? "Desconocido";
const yearLabel = YEARS.find((s) => s.id === year)?.label ?? "Desconocido";
const degreeLabel =
    DEGREES.find((s) => s.id === degree)?.label ?? "Desconocido";
const typeLabel = TYPES.find((s) => s.id === type)?.label ?? "Desconocido";
---

<a href={`/estudiantado/asignaturas/${slug}`}>
    <article style={`--bg: ${bg_color}`}>
        <div>
            <Tag color={degree_color}>
                <Icon name="lucide:graduation-cap" size={17} />
                {degreeLabel}
            </Tag>
            <div>
                <Tag color="pink">{yearLabel}</Tag>
                <Tag color="lightblue">{semesterLabel}</Tag>
            </div>
        </div>
        <div>
            <div>
                <h2>{name}</h2>
                <p>{description}</p>
            </div>
            <div>
                <CardDataHolder
                    icon="lucide:id-card"
                    title="Código"
                    value={code}
                />
                <CardDataHolder
                    icon="lucide:coins"
                    title="Créditos"
                    value={`${credits} ECTS`}
                />
                <CardDataHolder
                    icon="lucide:shield-alert"
                    title="Tipo"
                    value={typeLabel}
                />
            </div>
        </div>
    </article>
</a>

<style>
    a {
        width: min(90%, 648px);
        aspect-ratio: 648/261;
        border-radius: 10px;
        overflow: hidden;
        border: 1px solid rgba(128, 128, 128, 0.147);
        text-decoration: none;
        color: inherit;
        box-shadow: 0 0 10px rgba(0, 0, 0, 0.195);
        transition: scale 0.2s linear;

        &:hover {
            scale: 1.02;
        }
    }

    article {
        --bg: white;
        height: 100%;

        & > div:first-child {
            grid-row: 1;
            background: var(--bg);
            position: relative;
            padding: 15px 20px;
            display: flex;
            flex-wrap: nowrap;
            justify-content: space-between;
            align-items: center;

            div {
                display: flex;
                flex-wrap: nowrap;
                align-items: center;
                justify-content: center;
                gap: 10px;
            }
        }

        & > div:last-child {
            grid-row: 2;
            height: 100%;
            width: 100%;
            gap: 10px;
            padding: 20px;
            display: grid;
            grid-template-columns: 60% auto;
            justify-items: center;

            h2 {
                color: oklch(from var(--bg) round(1.21 - L) 0 0);
                color: contrast-color(var(--bg));
                margin-bottom: 10px;
            }

            p {
                color: color-mix(
                    var(--bg) 20%,
                    oklch(from var(--bg) round(1.21 - L) 0 0)
                );
                color: color-mix(var(--bg) 30%, contrast-color(var(--bg)));
                font-size: small;
                text-wrap: balance;
                text-wrap: pretty;
            }

            > div {
                display: flex;
                gap: 10px;
                height: 100%;
                flex-wrap: nowrap;
                flex-direction: column;
                width: fit-content;

                &:first-child {
                    justify-self: start;
                }
            }
        }
    }

    @media (max-width: 1032px) {
        article > div:first-child p {
            display: none;
        }
    }
</style>
