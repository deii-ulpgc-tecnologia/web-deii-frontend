---
import type { MarkdownSubject } from "@/types/Subject";
import { DEGREES, SEMESTERS, TYPES, YEARS } from "@/constants/SubjectsConfig";
import Tag from "@/components/base/Tag.astro";
import CardDataHolder from "@/components/subjects/CardDataHolder.astro";

export type Props = Omit<
    MarkdownSubject,
    "teaching_guide" | "subject_url" | "Content"
>;

const {
    name,
    degree,
    year,
    semester,
    description,
    type,
    bg_color,
    code,
    credits,
    slug,
    degree_color,
} = Astro.props;

const semesterLabel =
    SEMESTERS.find((s) => s.id === semester)?.label ?? "Desconocido";
const yearLabel = YEARS.find((s) => s.id === year)?.label ?? "Desconocido";
const degreeLabel =
    DEGREES.find((s) => s.id === degree)?.label ?? "Desconocido";
const typeLabel = TYPES.find((s) => s.id === type)?.label ?? "Desconocido";
---

<a href={`/estudiantado/asignaturas/${slug}`}>
    <article style={`--bg: ${bg_color}`}>
        <div>
            <Tag color={degree_color}>{degreeLabel}</Tag>
            <h2>{name}</h2>
            <p>{description}</p>
        </div>
        <div>
            <div>
                <CardDataHolder
                    icon="lucide:id-card"
                    title="Código"
                    value={code}
                />
                <CardDataHolder
                    icon="lucide:coins"
                    title="Créditos"
                    value={`${credits} ECTS`}
                />
                <CardDataHolder
                    icon="lucide:shield-alert"
                    title="Tipo"
                    value={typeLabel}
                />
            </div>
            <div>
                <CardDataHolder
                    icon="lucide:graduation-cap"
                    title="Semestre"
                    value={semesterLabel}
                />
                <CardDataHolder
                    icon="lucide:calendar-clock"
                    title="Curso"
                    value={yearLabel}
                />
            </div>
        </div>
    </article>
</a>

<style>
    a {
        width: min(90%, 550px);
        aspect-ratio: 640/405;
        border-radius: 10px;
        overflow: hidden;
        border: 1px solid rgba(128, 128, 128, 0.147);
        text-decoration: none;
        color: inherit;
        box-shadow: 0 0 10px rgba(0, 0, 0, 0.195);
        transition: scale 0.2s linear;

        &:hover {
            scale: 1.02;
        }
    }

    article {
        --bg: white;
        display: grid;
        grid-template-rows: 50% auto;
        height: 100%;

        & > div:first-child {
            grid-row: 1;
            background: var(--bg);
            position: relative;
            padding: 10px 20px;
            padding-top: 40px;

            & .tag {
                position: absolute;
                top: 5px;
                left: 5px;
            }

            h2 {
                color: oklch(from var(--bg) round(1.21 - L) 0 0);
                color: contrast-color(var(--bg));
                margin-bottom: 10px;
            }

            p {
                max-width: 60%;
                color: color-mix(
                    var(--bg) 20%,
                    oklch(from var(--bg) round(1.21 - L) 0 0)
                );
                color: color-mix(var(--bg) 30%, contrast-color(var(--bg)));
                font-size: small;
                text-wrap: balance;
                text-wrap: pretty;
            }
        }

        & > div:last-child {
            grid-row: 2;
            height: 100%;
            width: 100%;
            display: flex;
            justify-content: center;
            align-items: center;
            flex-direction: column;
            gap: 20px;
            padding: 20px;

            > div {
                display: flex;
                gap: 20px;
                width: 100%;
                flex-wrap: nowrap;
            }
        }
    }

    @media (max-width: 1032px) {
        article > div:first-child p {
            display: none;
        }
    }
</style>
