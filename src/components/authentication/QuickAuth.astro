---
import { Icon } from "astro-icon/components";
---

<button>
    <Icon name="lucide:user" />
    Iniciar Sesión
</button>

<style>
    button {
        background: var(--ulpgc-blue);
        color: white;
        border-radius: 10px;
        padding: 10px 20px;
        outline: none;
        display: flex;
        gap: 5px;
        font-size: inherit;
        border: solid transparent 2px;
        transition:
            scale linear 0.2s,
            color linear 0.3s,
            border linear 0.3s;

        &:hover {
            scale: 1.02;
            border-color: var(--ulpgc-orange);
            color: var(--ulpgc-orange);
        }

        &:active {
            scale: 0.99;
        }
    }
</style>
