---
---

<section>
    <article>
        <h1>
            Representamos y defendemos a los estudiantes de la{" "}
            <span>Escuela de Ingeniería Informática</span>
        </h1>
        <div>
            <a href="/difusion" class="primary">
                Canales de difusión
            </a>
            <a href="/sobre-nosotros">Conoce a la delegación</a>
        </div>
    </article>
    <img
        src="/images/foto-de-familia.jpg"
        alt="Foto de familia de la delegación"
        loading="eager"
    />
    <div aria-hidden class="content"></div>
</section>

<style>
    section {
        position: relative;
        width: 100%;
        height: 85dvh;
        overflow: hidden;
        display: grid;
        grid-template-columns: 40% auto;
        grid-template-rows: 100%;

        article {
            width: 100%;
            height: 100%;
            min-height: 0;
            padding: 2rem;
            color: white;
            text-align: center;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            background-color: var(--ulpgc-blue);
            gap: 40px;

            h1 {
                font-size: 42px;

                span {
                    color: color-mix(var(--ulpgc-orange) 70%, white);
                }
            }

            div {
                display: flex;
                gap: 20px;
                justify-content: center;

                a {
                    border: 5px solid white;
                    border-radius: 10px;
                    padding: 10px 20px;
                    text-decoration: none;
                    color: white;
                    font-weight: bold;
                    transition: all 0.3s linear;

                    &:hover {
                        color: var(--ulpgc-blue);
                        background: white;
                    }

                    &.primary {
                        border-color: var(--ulpgc-orange);
                        background: var(--ulpgc-orange);

                        &:hover {
                            background: var(--ulpgc-orange-dark);
                            color: white;
                            border-color: var(--ulpgc-orange-dark);
                        }
                    }
                }
            }
        }

        img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .content {
            --opacity-start: 100%;
            --opacity-finish: 40%;
            background: color-mix(
                var(--ulpgc-blue-dark) var(--opacity-finish),
                transparent
            );
            background: linear-gradient(
                90deg,
                color-mix(var(--ulpgc-blue) var(--opacity-start), transparent)
                    0%,
                color-mix(
                        var(--ulpgc-blue-dark) var(--opacity-finish),
                        transparent
                    )
                    10%
            );
            position: absolute;
            left: 40%;
            top: 0;
            width: 60%;
            height: 100%;
        }
    }

    @media (max-width: 1032px) {
        section {
            height: 90dvh;
            display: flex;
            flex-direction: column;

            article {
                gap: 20px;
                height: 60%;

                h1 {
                    font-size: 23px;
                }

                div {
                    a {
                        padding: 5px 10px;
                        font-size: 12px;
                        border: 2px solid white;
                        text-wrap: nowrap;
                    }
                }
            }

            .content {
                background: linear-gradient(
                    180deg,
                    color-mix(
                            var(--ulpgc-blue) var(--opacity-start),
                            transparent
                        )
                        0%,
                    color-mix(
                            var(--ulpgc-blue-dark) var(--opacity-finish),
                            transparent
                        )
                        10%
                );
                position: absolute;
                left: 0;
                top: 40%;
                width: 100%;
                height: 60%;
            }
        }
    }
</style>
